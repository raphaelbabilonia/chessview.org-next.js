#!/usr/bin/python3
"""ChessView production guard on KVM8 (replaces .github/workflows/production-guard.yml, 25 Nov 2026).

Source: chessview.org-next.js/ops/production-guard/ (installed by install.sh as /usr/local/sbin/hoc-chessview-guard).
Run every 15 minutes by hoc-chessview-guard.timer, as root.

Same checks as the old workflow: /_health ok, /en, /en/events, /sitemap.xml and /robots.txt answer 200, and 100
requests to /_health (20 at a time) give at most one 5xx and no incomplete answer. The live deploymentSha must be
the commit on main (or the commit kingdom-deploy deliberately kept live: a docs-only commit it skipped, or a commit
it blocked).

Same ownership rule: the guard acts only when main's head is a `[growth-run:<id>]` commit at least 30 minutes old.
Then, if the site is technically failing on that commit, it puts the previous release back
(`kingdom-deploy rollback chessview-web`, or `hoc-chessview-ops rollback-web <sha>` when kingdom-deploy keeps no
earlier artifact), and it reverts that commit on main (refusing if main moved). Any other incident makes the unit
fail (exit 1), which KVM8's health check reports to Lumo. A release in progress is never judged.

Records: /var/lib/hoc-chessview-guard/last.json and history.jsonl. Prints no secret.
"""
import concurrent.futures
import datetime
import fcntl
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

SITE = 'https://chessview.org'
APP = 'chessview-web'
STATE = Path('/var/lib/hoc-chessview-guard')
KD_STATE = Path('/var/lib/kingdom-deploy') / APP / 'state.json'
LOCKS = [Path('/run/lock') / f'kingdom-deploy-{APP}.lock', Path('/var/lib/hoc-chessview-deploy/deploy.lock')]
KEY = Path('/etc/hoc-secrets/chessview/production-guard-github')
KNOWN_HOSTS = Path('/etc/kingdom-deploy/github-known-hosts')
REMOTE = 'git@github.com:raphaelbabilonia/chessview.org-next.js.git'
WARMUP_SECONDS = 1800
UA = {'User-Agent': 'ChessView-Production-Guard/2 (KVM8)', 'Cache-Control': 'no-cache'}


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')


def get(path, timeout, retries=2):
    """(status, body); status 0 when no complete answer came back (like curl's 000)."""
    status, body = 0, b''
    for attempt in range(retries + 1):
        try:
            with urllib.request.urlopen(urllib.request.Request(SITE + path, headers=UA), timeout=timeout) as r:
                return r.status, r.read()
        except urllib.error.HTTPError as e:
            status, body = e.code, b''
            if status < 500:
                return status, body
        except (OSError, ValueError):
            status, body = 0, b''
        if attempt < retries:
            time.sleep(2)
    return status, body


def sample(_):
    try:
        with urllib.request.urlopen(urllib.request.Request(SITE + '/_health', headers=UA), timeout=15) as r:
            r.read()
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except (OSError, ValueError):
        return 0


def release_in_progress():
    for path in LOCKS:
        if not path.exists():
            continue
        with path.open('a') as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(f, fcntl.LOCK_UN)
            except BlockingIOError:
                return True
    return False


def git(*args, check=True):
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    env.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1', GIT_TERMINAL_PROMPT='0',
               GIT_SSH_COMMAND=(f'ssh -i {KEY} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes '
                                f'-o UserKnownHostsFile={KNOWN_HOSTS}'))
    p = subprocess.run(['git', '-C', str(STATE / 'repo'), *args], capture_output=True, text=True, env=env, timeout=300)
    if check and p.returncode:
        raise RuntimeError(f'git {args[0]} failed (exit {p.returncode}): {p.stderr.strip()[-300:]}')
    return p.stdout.strip()


def main_head():
    repo = STATE / 'repo'
    if not (repo / '.git').exists():
        repo.mkdir(parents=True, exist_ok=True)
        git('init', '--quiet')
        git('remote', 'add', 'origin', REMOTE)
    git('fetch', '--quiet', '--no-tags', 'origin', '+refs/heads/main:refs/remotes/origin/main')
    sha = git('rev-parse', 'origin/main')
    subject = git('show', '-s', '--format=%s', sha)
    epoch = int(git('show', '-s', '--format=%ct', sha))
    return sha, subject, int(time.time()) - epoch


def probe():
    reasons, technical = [], False
    status, body = get('/_health', 15)
    try:
        health = json.loads(body) if status == 200 else {}
    except ValueError:
        health = {}
    if not isinstance(health, dict) or health.get('ok') is not True:
        health = health if isinstance(health, dict) else {}
        reasons.append('health')
        technical = True
    for path, timeout, name in (('/en', 20, 'home'), ('/en/events', 30, 'events'),
                                ('/sitemap.xml', 30, 'sitemap'), ('/robots.txt', 15, 'robots')):
        code, _ = get(path, timeout)
        if code != 200:
            reasons.append(f'{name}:{code:03d}')
            technical = True
    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:
        codes = list(pool.map(sample, range(100)))
    server_errors = sum(1 for c in codes if 500 <= c < 600)
    incomplete = sum(1 for c in codes if c == 0)
    if server_errors > 1:
        reasons.append(f'5xx:{server_errors}/100')
        technical = True
    if incomplete:
        reasons.append(f'incomplete-samples:{incomplete}')
        technical = True
    return str(health.get('deploymentSha') or ''), reasons, technical


def record(entry, code):
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    entry = {'checked_utc': now(), **entry}
    (STATE / 'last.json').write_text(json.dumps(entry, indent=2) + '\n')
    if entry['result'] not in ('healthy', 'release_in_progress', 'warming', 'maintenance'):
        with (STATE / 'history.jsonl').open('a') as f:
            f.write(json.dumps(entry) + '\n')
    print(json.dumps(entry))
    return code


def rollback_production(head):
    p = subprocess.run(['/usr/local/sbin/kingdom-deploy', 'rollback', APP], capture_output=True, text=True, timeout=1200)
    try:
        result = json.loads(p.stdout.strip().splitlines()[-1]) if p.stdout.strip() else {}
    except ValueError:
        result = {}
    if p.returncode == 0 and result.get('healthy'):
        return f"kingdom-deploy rollback to {result.get('revision')}"
    first = p.returncode
    p = subprocess.run(['/usr/local/sbin/hoc-chessview-ops', 'rollback-web', head], capture_output=True, text=True, timeout=900)
    if p.returncode == 0:
        return 'hoc-chessview-ops rollback-web (kingdom-deploy kept no earlier artifact)'
    raise RuntimeError(f'both rollbacks failed (kingdom-deploy exit {first}, hoc-chessview-ops exit {p.returncode})')


def revert_on_main(head, reason):
    git('fetch', '--quiet', '--no-tags', 'origin', '+refs/heads/main:refs/remotes/origin/main')
    if git('rev-parse', 'origin/main') != head:
        raise RuntimeError('main moved; refusing an unsafe automatic revert')
    git('checkout', '--quiet', '--force', '--detach', head)
    who = ['-c', 'user.name=ChessView Production Guard', '-c', 'user.email=actions@users.noreply.github.com']
    git(*who, 'revert', '--no-edit', head)
    git(*who, 'commit', '--quiet', '--amend', '-m', f'Revert growth release {head} (production guard: {reason})')
    revert = git('rev-parse', 'HEAD')
    git('push', '--quiet', 'origin', 'HEAD:main')
    return revert


def main():
    os.umask(0o077)
    assert os.geteuid() == 0, 'run as root on KVM8'
    if Path('/var/lib/hoc-infra/chessview-maintenance').exists():
        return record({'result': 'maintenance'}, 0)
    if release_in_progress():
        return record({'result': 'release_in_progress'}, 0)
    head, subject, age = main_head()
    live, reasons, technical = probe()
    kd = json.loads(KD_STATE.read_text()) if KD_STATE.exists() else {}
    deployed = kd.get('deployed')
    owns = subject.startswith('[growth-run:') and age >= WARMUP_SECONDS
    # A commit kingdom-deploy skipped (docs only) or blocked keeps the last good release live on purpose; a blocked
    # growth commit is still the guard's to revert on main, as the old workflow did.
    kept_live = bool(deployed) and live == deployed and (head == kd.get('seen') or (head == kd.get('blocked') and not owns))
    sha_ok = bool(live) and (live == head or kept_live)
    if not sha_ok:
        reasons.append('deployment-sha-mismatch')
    entry = {'main': head, 'live': live, 'kingdom_deploy_deployed': deployed, 'reasons': reasons or ['none'],
             'main_age_seconds': age}
    if not technical and sha_ok:
        note = {} if live == head else {'note': 'main is blocked or skipped by kingdom-deploy; its record owns that'}
        return record({'result': 'healthy', **entry, **note}, 0)
    reason = ','.join(reasons)
    if owns:
        actions = []
        try:
            if technical and live == head:
                actions.append(rollback_production(head))
            actions.append(f'reverted on main as {revert_on_main(head, reason)}')
        except (RuntimeError, subprocess.SubprocessError) as error:
            return record({'result': 'guard_action_failed', **entry, 'actions': actions, 'error': str(error)[:400]}, 1)
        return record({'result': 'growth_release_rolled_back', **entry, 'actions': actions}, 0)
    if not technical and age < WARMUP_SECONDS:
        return record({'result': 'warming', **entry}, 0)
    return record({'result': 'unhealthy_not_owned', **entry,
                   'note': 'the guard did not change main; see kingdom-deploy status chessview-web'}, 1)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as error:   # network or GitHub trouble: report, never act half-way
        sys.exit(record({'result': 'guard_error', 'error': str(error)[:400]}, 1))
